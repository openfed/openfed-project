{
    "name": "openfed/openfed-project",
    "description": "Project template for Drupal 11 sites built with the Openfed distribution.",
    "type": "project",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Blue4You",
            "role": ""
        }
    ],
    "repositories": [
        {
            "type": "composer",
            "url": "https://packages.drupal.org/8"
        }
    ],
    "require": {
        "composer/installers": "^2.3",
        "wikimedia/composer-merge-plugin": "^2.1"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "composer-patches": {
            "package-depths": {
                "drupal/core": 2
            },
            "patches-file": "composer.patches.json"
        },
        "merge-plugin": {
            "require": [
                "composer.openfed.json"
            ],
            "include": [
                "docroot/modules/contrib/webform/composer.libraries.json",
                "docroot/modules/contrib/ckeditor_codemirror/composer.libraries.json"
            ],
            "recurse": true,
            "replace": false,
            "ignore-duplicates": false,
            "merge-dev": true,
            "merge-extra": true,
            "merge-extra-deep": true,
            "merge-scripts": true
        },
        "installer-types": [
            "simplesamlphp-module",
            "theme-library"
        ],
        "installer-paths": {
            "docroot/core": [
                "type:drupal-core"
            ],
            "docroot/libraries/{$name}": [
                "type:drupal-library",
                "type:theme-library"
            ],
            "docroot/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "docroot/profiles/contrib/openfed": [
                "type:drupal-profile"
            ],
            "docroot/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/contrib/{$name}": [
                "type:drupal-drush"
            ],
            "docroot/libraries/simplesamlphp/modules/{$name}": [
                "type:simplesamlphp-module"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "./docroot"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3"
        },
        "allow-plugins": {
            "simplesamlphp/composer-module-installer": true,
            "composer/installers": true,
            "mnsami/composer-custom-directory-installer": true,
            "cweagans/composer-patches": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "wikimedia/composer-merge-plugin": true,
            "szeidler/composer-patches-cli": true,
            "simplesamlphp/composer-xmlprovider-installer": true,
            "symfony/runtime": true
        }
    }
}
